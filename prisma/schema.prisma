generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum IncomeLevel {
  UNSPECIFIED
  LOW
  MIDDLE
  HIGH
}

enum DatasetImportStatus {
  PENDING
  COMPLETED
  FAILED
}

enum ChatRole {
  USER
  ASSISTANT
}

enum AiPurpose {
  RECOMMENDATION
  RECIPE_CHAT
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  profile             UserProfile?
  refreshSessions     RefreshSession[]
  passwordResetTokens PasswordResetToken[]
  chatSessions        RecipeChatSession[]
  aiUsage             AiUsage[]
}

model UserProfile {
  id               String       @id @default(cuid())
  userId           String       @unique
  fullName         String?
  age              Int?
  householdSize    Int?
  mealsPerDay      Int?
  incomeLevel      IncomeLevel?
  weeklyFoodBudget Decimal?     @db.Decimal(12, 2)
  dietPreferences  String[]     @default([])
  allergens        String[]     @default([])
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshSession {
  id                  String    @id @default(cuid())
  userId              String
  familyId            String
  tokenHash           String    @unique
  expiresAt           DateTime
  revokedAt           DateTime?
  replacedByTokenHash String?
  createdAt           DateTime  @default(now())
  lastUsedAt          DateTime?
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model DatasetImport {
  id              String              @id @default(cuid())
  checksum        String              @unique
  sourceFile      String
  status          DatasetImportStatus @default(PENDING)
  active          Boolean             @default(false)
  recipeCount     Int                 @default(0)
  ingredientCount Int                 @default(0)
  pricedCount     Int                 @default(0)
  summary         Json?
  createdAt       DateTime            @default(now())
  completedAt     DateTime?
  recipes         Recipe[]

  @@index([active, status])
}

model Ingredient {
  id                String             @id
  canonicalName     String
  normalizedName    String
  aliases           IngredientAlias[]
  recipeIngredients RecipeIngredient[]

  @@index([normalizedName])
}

model IngredientAlias {
  id              String     @id @default(cuid())
  ingredientId    String
  alias           String
  normalizedAlias String     @unique
  ingredient      Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@index([ingredientId])
}

model Recipe {
  id                      String              @id
  datasetImportId         String
  title                   String
  normalizedTitle         String
  description             String?
  category                String?
  servings                Decimal?            @db.Decimal(10, 2)
  servingType             String?
  preparationMinutes      Int?
  cookingMinutes          Int?
  difficulty              String?
  cookingMethods          String[]            @default([])
  defaultEstimatedCostTry Decimal?            @db.Decimal(12, 2)
  estimatedCostIsPartial  Boolean             @default(true)
  costableIngredientCount Int                 @default(0)
  totalIngredientCount    Int                 @default(0)
  costCoverageRatio       Decimal?            @db.Decimal(8, 6)
  costType                String?
  priceReferenceDate      DateTime?           @db.Date
  costReliability         String?
  allergenCategories      String[]            @default([])
  allergenDataStatus      String              @default("inferred")
  missingCoreIngredient   Boolean             @default(false)
  sourceMetadata          Json?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  datasetImport           DatasetImport       @relation(fields: [datasetImportId], references: [id], onDelete: Restrict)
  ingredients             RecipeIngredient[]
  steps                   RecipeStep[]
  chatSessions            RecipeChatSession[]

  @@index([datasetImportId])
  @@index([normalizedTitle])
  @@index([category])
  @@index([difficulty])
}

model RecipeIngredient {
  id                      String      @id @default(cuid())
  recipeId                String
  ingredientId            String?
  position                Int
  displayName             String
  normalizedName          String
  displayAmount           Decimal?    @db.Decimal(16, 4)
  displayUnit             String?
  quantity                Decimal?    @db.Decimal(16, 4)
  unit                    String?
  costQuantity            Decimal?    @db.Decimal(16, 4)
  costUnit                String?
  pricePerCostUnitTry     Decimal?    @db.Decimal(16, 6)
  defaultEstimatedCostTry Decimal?    @db.Decimal(12, 2)
  costStatus              String
  recipe                  Recipe      @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient              Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: SetNull)

  @@unique([recipeId, position])
  @@index([ingredientId])
  @@index([normalizedName])
}

model RecipeStep {
  id       String @id @default(cuid())
  recipeId String
  order    Int
  text     String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([recipeId, order])
}

model RecipeChatSession {
  id        String              @id @default(cuid())
  userId    String
  recipeId  String
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe    Recipe              @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  messages  RecipeChatMessage[]

  @@index([userId, createdAt])
}

model RecipeChatMessage {
  id             String            @id @default(cuid())
  sessionId      String
  role           ChatRole
  content        String
  provider       String?
  model          String?
  fallback       Boolean           @default(false)
  fallbackReason String?
  createdAt      DateTime          @default(now())
  session        RecipeChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model AiUsage {
  id                String    @id @default(cuid())
  userId            String?
  purpose           AiPurpose
  provider          String
  model             String
  providerRequestId String?
  inputTokens       Int       @default(0)
  cachedInputTokens Int       @default(0)
  outputTokens      Int       @default(0)
  estimatedUsd      Decimal   @default(0) @db.Decimal(12, 8)
  fallback          Boolean   @default(false)
  fallbackReason    String?
  createdAt         DateTime  @default(now())
  user              User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
}

model RateLimitBucket {
  key         String
  windowStart DateTime
  count       Int      @default(1)
  expiresAt   DateTime

  @@id([key, windowStart])
  @@index([expiresAt])
}
