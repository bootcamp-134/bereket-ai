{
  "name": "bereket-ai-backend",
  "version": "1.0.0-rc.1",
  "private": true,
  "description": "Bereket AI mobile app backend API",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "nest build",
    "ci": "pnpm lint && pnpm test && pnpm build && pnpm audit --prod",
    "db:deploy": "prisma migrate deploy",
    "db:import": "tsx scripts/import-recipes.ts",
    "db:status": "prisma migrate status",
    "dev": "nest start --watch",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\" \"test/**/*.ts\" \"docs/**/*.md\" \"README.md\" && prisma format",
    "lint": "tsc --noEmit",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "vercel-build": "pnpm db:deploy && pnpm db:import && pnpm build"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@node-rs/argon2": "2.0.2",
    "@prisma/adapter-neon": "7.9.1",
    "@prisma/client": "7.9.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "helmet": "8.3.0",
    "openai": "7.3.0",
    "reflect-metadata": "^0.2.2",
    "resend": "6.18.1",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "11.1.28",
    "@prisma/adapter-pg": "7.9.1",
    "@types/pg": "^8.16.0",
    "@types/node": "^24.13.2",
    "@types/express": "^5.0.6",
    "@types/supertest": "^6.0.3",
    "prettier": "^3.9.4",
    "pg": "^8.16.3",
    "prisma": "7.9.1",
    "supertest": "7.2.2",
    "ts-node": "^10.9.2",
    "tsx": "4.23.4",
    "typescript": "^6.0.3",
    "vitest": "4.1.10"
  }
}
